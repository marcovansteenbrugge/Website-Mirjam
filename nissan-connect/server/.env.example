# ---------------------------------------------------------------------------
# Nissan Ariya Connect -- voorbeeldconfiguratie
#
# Kopieer dit bestand naar `.env` en vul je eigen waarden in:
#     cp .env.example .env
#
# In dit bestand staan GEEN echte waarden. Zet `.env` nooit in git.
# ---------------------------------------------------------------------------


# === Toegang tot deze app ==================================================

# Gedeeld token waarmee de webpagina zich bij de backend meldt.
# De frontend stuurt dit mee als:  Authorization: Bearer <token>
#
# VERPLICHT. Minimaal 16 tekens -- de server weigert anders te starten.
# Dit is geen formaliteit: met dit token kan iemand jouw auto laten
# voorverwarmen. Maak een lang, willekeurig token aan met:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
APP_TOKEN=


# === Nissan-account ========================================================
# Alleen nodig als MOCK niet aan staat. Deze gegevens blijven op de server en
# worden nooit naar de browser gestuurd of gelogd.

# E-mailadres van je NissanConnect-account (hetzelfde als in de Nissan-app).
NISSAN_USERNAME=

# Wachtwoord van je NissanConnect-account.
NISSAN_PASSWORD=

# Land van je Nissan-account, als landcode van twee letters.
# Standaard NL. Alle Europese landcodes gaan naar dezelfde Nissan-EU-backend;
# regio's buiten Europa worden niet ondersteund (die instellingen zijn niet
# uit betrouwbare broncode te halen en worden niet gegokt).
NISSAN_REGION=NL


# === Modus =================================================================

# Zet op 1 om te draaien met een nagebootste Ariya: geen Nissan-account nodig,
# geen echt verkeer naar de auto. Handig om de webpagina te ontwikkelen of te
# demonstreren. Zet op 0 (of laat leeg) voor de echte auto.
MOCK=1


# === Bescherming van de 12V-accu ===========================================

# Minimale tijd (in seconden) tussen twee GEFORCEERDE metingen
# (POST /api/battery/refresh). Standaard 900 = 15 minuten.
#
# Waarom dit belangrijk is: een geforceerde meting maakt de auto echt wakker.
# Te vaak pollen trekt de kleine 12V-startaccu leeg, en met een lege 12V-accu
# doet de auto helemaal niets meer -- ook de laadklep niet. Verlaag deze waarde
# dus niet zomaar.
#
# Let op: het gewone uitlezen (GET /api/battery) valt hier niet onder. Dat leest
# alleen wat Nissan al in de cloud heeft staan en raakt de auto niet aan.
POLL_MIN_INTERVAL_SECONDS=900


# === Afhandeling van langlopende opdrachten (geavanceerd) ==================

# Hoe lang een opdracht (verse meting, voorverwarmen) maximaal mag duren
# voordat hij de status `timeout` krijgt. De frontend pollt maximaal 90
# seconden, dus houd dit daaronder.
JOB_TIMEOUT_SECONDS=75

# Hoe vaak de server tussentijds bij de auto navraagt of de opdracht al gelukt is.
JOB_POLL_INTERVAL_SECONDS=10

# Hoe lang een afgeronde opdracht opvraagbaar blijft via GET /api/jobs/{id}.
# 600 seconden = 10 minuten.
JOB_TTL_SECONDS=600


# === Gedrag van de mock (alleen als MOCK=1) ================================

# Kans (0.0 t/m 1.0) dat een gesimuleerd commando mislukt met `vehicle_asleep`.
# Zo kun je de foutafhandeling van de webpagina echt uitproberen.
# Zet op 0 als je een rustige demo wilt.
MOCK_FAILURE_RATE=0.12
